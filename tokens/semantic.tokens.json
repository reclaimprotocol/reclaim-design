{
  "$description": "Semantic and component token contract. Theme files provide values for every themeable leaf.",
  "component": {
    "button": {
      "height": {"$type": "dimension", "$value": "{size.control}"},
      "padding-inline": {"$type": "dimension", "$value": "{space.150}"},
      "primary": {
        "background": {
          "$type": "gradient",
          "$value": "{gradient.action-primary}"
        },
        "background-hover": {
          "$type": "gradient",
          "$value": "{gradient.action-primary-hover}"
        },
        "foreground": {"$type": "color", "$value": "{color.text.on-action}"}
      }
    },
    "field": {
      "height": {"$type": "dimension", "$value": "{size.field}"},
      "border": {"$type": "color", "$value": "{color.border.strong}"}
    },
    "card": {
      "padding": {"$type": "dimension", "$value": "{space.250}"},
      "padding-compact": {"$type": "dimension", "$value": "{space.200}"},
      "background": {"$type": "color", "$value": "{color.surface.panel}"},
      "border": {"$type": "color", "$value": "{color.border.default}"}
    },
    "period": {
      "border-gap": {"$type": "dimension", "$value": "0px"},
      "option": {
        "font-size": {"$type": "dimension", "$value": "{font.size.control}"},
        "padding-block": {"$type": "dimension", "$value": "0px"},
        "padding-inline": {"$type": "dimension", "$value": "{space.150}"}
      }
    }
  }
}
